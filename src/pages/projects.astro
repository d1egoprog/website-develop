---
import MainLayout from "../layouts/MainLayout.astro";

// Preserve the six placeholder entries and category assignments from sandbox/packages.html.
// Replace these entries with real project information when it is available.
const projects = [
    { title: "Docker Dummy", categories: ["docker", "research"], icon: "fa-brands fa-docker" },
    { title: "Prototypes Dummy", categories: ["docker", "prototypes"], icon: "fa-solid fa-atom" },
    { title: "Research Dummy", categories: ["research", "prototypes"], icon: "fa-solid fa-flask" },
    { title: "Docker Dummy", categories: ["docker", "research"], icon: "fa-brands fa-docker" },
    { title: "Prototypes Dummy", categories: ["docker", "prototypes"], icon: "fa-solid fa-atom" },
    { title: "Research Dummy", categories: ["research", "prototypes"], icon: "fa-solid fa-flask" },
];
const filters = [
    { label: "All", value: "all" },
    { label: "Docker", value: "docker" },
    { label: "Research", value: "research" },
    { label: "Prototypes", value: "prototypes" },
];
---
<MainLayout
    title="Projects"
    description="Packages and software projects by Diego Rincon-Yanez. This collection currently contains placeholder entries for Docker, research, and prototypes."
    pageType="CollectionPage"
>
    <section class="portfolio_area container" id="projects" aria-labelledby="projects-title">
        <div class="main_title">
            <h1 id="projects-title">Packages and Software</h1>
        </div>
        <p class="projects-intro">Project details are coming soon. The entries below are placeholders.</p>
        <div class="porfolio_menu" role="group" aria-label="Filter projects by category" hidden>
            <ul class="causes_filter">
                {filters.map(({ label, value }) => (
                    <li class:list={[{ active: value === "all" }]}>
                        <button
                            type="button"
                            data-project-filter={value}
                            aria-pressed={value === "all" ? "true" : "false"}
                            aria-controls="project-list"
                        >
                            {label}
                        </button>
                    </li>
                ))}
            </ul>
        </div>
        <p class="sr-only" id="project-status" role="status" aria-live="polite" aria-atomic="true">
            Showing all 6 projects.
        </p>
        <div class="portfolio_list_inner projects-grid" id="project-list">
            {projects.map((project, index) => (
                <article
                    class="portfolio_item"
                    data-project-categories={project.categories.join(" ")}
                    aria-labelledby={`project-${index}`}
                >
                    <div class="project-icon" aria-hidden="true">
                        <i class={project.icon}></i>
                    </div>
                    <div class="portfolio_title">
                        <h2 id={`project-${index}`}>{project.title}</h2>
                        <p>Placeholder</p>
                    </div>
                </article>
            ))}
        </div>
    </section>
</MainLayout>

<style>
    #projects {
        padding-bottom: 40px;
    }

    .projects-intro {
        text-align: center;
        margin-bottom: 24px;
    }

    #projects .projects-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
        max-width: none;
    }

    #projects .portfolio_item {
        margin-top: 0;
    }

    .project-icon {
        display: grid;
        place-items: center;
        min-height: 160px;
        background: #dce6f1;
        color: #36567e;
        font-size: 64px;
    }

    #projects [hidden] {
        display: none;
    }

    @media (max-width: 991px) {
        #projects .projects-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 575px) {
        #projects .projects-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    const section = document.querySelector<HTMLElement>("#projects");
    if (section) {
        const buttons = section.querySelectorAll<HTMLButtonElement>("[data-project-filter]");
        const cards = section.querySelectorAll<HTMLElement>("[data-project-categories]");
        const status = section.querySelector<HTMLElement>("#project-status");

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                const filter = button.dataset.projectFilter;
                let visibleCount = 0;
                cards.forEach((card) => {
                    const categories = card.dataset.projectCategories?.split(" ") ?? [];
                    card.hidden = filter !== "all" && !categories.includes(filter ?? "");
                    if (!card.hidden) visibleCount++;
                });
                buttons.forEach((candidate) => {
                    const active = candidate === button;
                    candidate.closest("li")?.classList.toggle("active", active);
                    candidate.setAttribute("aria-pressed", String(active));
                });
                if (status) {
                    status.textContent = filter === "all"
                        ? `Showing all ${visibleCount} projects.`
                        : `Showing ${visibleCount} ${button.textContent?.trim()} projects.`;
                }
            });
        });
        const controls = section.querySelector<HTMLElement>(".porfolio_menu");
        if (controls) controls.hidden = false;
    }
</script>
