---
import { getCollection } from "astro:content";

import IndustryCard from "./IndustryCard.astro";

const industry = await getCollection("industry");

industry.sort((b,a)=> a.data.order-b.data.order);
---
    
<div class="col-md-2">
    <h3>
        <i class="fa-solid fa-industry"></i> 
            Industry Experience
    </h3>
</div>
<div class="col-md-10">
<p> 
    <table>{
        industry.map(item=>
            <IndustryCard industry={item}/>
        )
    }</table>
</p>  
</div>
