---
import { sitePath } from "../../lib/urls";
import Menu from "./Menu.astro";
import Social from "./Social.astro";
---
<footer class="footer_area">
    <div class="footer_copyright">
        <div class="container">
            <div class="pull-left">
                <h5>
                    Copyright &copy; Since 2020 All rights reserved 
                </h5>
            </div>
            <div class="pull-right">
                <Menu />
            </div>
        </div>
    </div>
    <div class="footer_inner ">
        <div class="container">
            <div class="pull-left"><img src={sitePath("img/footer-logo.png")} alt=""></div>
            <div class="pull-right">    
                <Social />
            </div>
        </div>
    </div>
</footer>