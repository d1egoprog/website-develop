@book{AlvaroOspinaSanjuan2011,
   abstract = {La iniciativa Grid Colombia tiene por objetivo contribuir al desarrollo científico de Colombia por medio del montaje y la operación de un grid de cómputo de alcance nacional. La infraestructura desarrollada tiene características de escalabilidad y disponibilidad de recursos de cómputo distribuidos, los cuales son administrados para lograr una operación estable y segura. Los componentes de interfaz facilitan el uso de los recursos por parte de los usuarios. El grid nacional tiene la capacidad de expandirse mediante la interconexión a otras mallas computacionales internacionales. El aporte de Grid Colombia —incluso más importante que la infraestructura tecnológica— es la formación de una comunidad de investigadores que trabaja bajo un esquema cooperativo, en el que, aun cuando sus participantes tengan diferentes capacidades en los recursos y servicios ofrecidos, se propicia un ambiente de colaboración científica y técnica. El presente trabajo hace parte de los productos de la iniciativa Grid Colombia y, como tal, aporta al logro de sus objetivos generales, al poner a disposición de la comunidad académica un procedimiento sistémico y optimizado que guía la conexión de un clúster a la malla de coómputo nacional Grid Colombia. Los objetivos son, por un lado, facilitar la participación de las diferentes instituciones educativas en esta iniciativa y, por el otro, apoyar la evolución, crecimiento, actualización y consolidación de los recursos técnicos y tecnológicos que el Gobierno nacional y las diferentes instituciones participantes en el proyecto Grid Colombia y RENATA ofrecen a la comunidad académica y científica.},
   author = {Álvaro Ospina Sanjuan and Enrique Gonzalez Guerrero and Diego Alberto Rincon Yanez and Julián Castaño Marín and Claudia Carmona Rodríguez},
   edition = {1},
   isbn = {78-958-716-503-6},
   issue = {1},
   journal = {Editorial Pontificia Universidad Javeriana},
   pages = {1-80},
   publisher = {Pontificia Universidad Javeriana},
   title = {Conexión de un nodo a Grid Colombia},
   volume = {1},
   year = {2011}
}

