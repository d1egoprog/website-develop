---
import { sitePath, canonicalPath } from "../lib/urls";
import Navbar from "../components/navigation/Navbar.astro";
import Footer from "../components/navigation/Footer.astro";

import { HOME_TITLE, PERSON, PERSON_NAME, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from "../consts";

interface Props {
    title?: string;
    description?: string;
    pageType?: "WebPage" | "ProfilePage" | "ContactPage" | "CollectionPage";
    noindex?: boolean;
}

const {
    title = "",
    description = SITE_DESCRIPTION,
    pageType = "WebPage",
    noindex = false,
} = Astro.props;
const pageTitle = title.trim() ? `${title.trim()} | ${SITE_TITLE}` : HOME_TITLE;
// Use the production origin and the current pathname, without tracking queries or fragments.
const canonicalURL = new URL(canonicalPath(Astro.url.pathname), SITE_URL).href;
const preventIndexing = noindex || import.meta.env.SITE_NOINDEX === "true";
const faviconURL = sitePath("img/fav-icon.png");
const socialImage = new URL("img/avatars/casual.jpg", SITE_URL).href;
const socialImageAlt = `Portrait of ${PERSON_NAME}`;
const websiteId = `${SITE_URL}#website`;
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        PERSON,
        {
            "@type": "WebSite",
            "@id": websiteId,
            url: SITE_URL,
            name: SITE_TITLE,
            description: SITE_DESCRIPTION,
            inLanguage: "en",
            publisher: { "@id": PERSON["@id"] },
        },
        {
            "@type": pageType,
            "@id": `${canonicalURL}#webpage`,
            url: canonicalURL,
            name: pageTitle,
            description,
            inLanguage: "en",
            isPartOf: { "@id": websiteId },
            about: { "@id": PERSON["@id"] },
            ...(pageType === "ProfilePage" ? { mainEntity: { "@id": PERSON["@id"] } } : {}),
        },
    ],
};
---

<!doctype html>
<html lang="en">

 <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content={preventIndexing ? "noindex, follow" : "index, follow"}>
        <meta name="author" content={PERSON_NAME}>
        <title>{pageTitle}</title>
        <link rel="canonical" href={canonicalURL}>
        <link rel="icon" href={faviconURL} type="image/png">
        <meta name="description" content={description}>

        <meta property="og:type" content="website">
        <meta property="og:site_name" content={SITE_TITLE}>
        <meta property="og:url" content={canonicalURL}>
        <meta property="og:title" content={pageTitle}>
        <meta property="og:description" content={description}>
        <meta property="og:image" content={socialImage}>
        <meta property="og:image:type" content="image/jpeg">
        <meta property="og:image:width" content="867">
        <meta property="og:image:height" content="866">
        <meta property="og:image:alt" content={socialImageAlt}>

        <!-- The existing portrait suits a square summary card. -->
        <meta name="twitter:card" content="summary">
        <meta name="twitter:creator" content="@d1egoprog">
        <meta name="twitter:title" content={pageTitle}>
        <meta name="twitter:description" content={description}>
        <meta name="twitter:image" content={socialImage}>
        <meta name="twitter:image:alt" content={socialImageAlt}>

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
        />

        <link href={sitePath("css/bootstrap.min.css")} rel="stylesheet">
        
        <link href={sitePath("css/style.css")} rel="stylesheet">
        <link href={sitePath("css/responsive.css")} rel="stylesheet">
        
        <link href={sitePath("assets/fontawesome/css/fontawesome.css")} rel="stylesheet">
        <link href={sitePath("assets/fontawesome/css/brands.css")} rel="stylesheet">
        <link href={sitePath("assets/fontawesome/css/solid.css")} rel="stylesheet">

    </head>

<body>
<header class="header_area">
    <div class="container">
        <Navbar />
     </div>                
</header>

<div class="main_container">
    <div class="content_inner_bg">
        <main>
            <slot />
        </main>
    </div>
</div>

<Footer />

<!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
<script is:inline src={sitePath("js/jquery-2.1.4.min.js")}></script>
<!-- Include all compiled plugins (below), or include individual files as needed -->
<script is:inline src={sitePath("js/bootstrap.min.js")}></script>

</body>

</html>
